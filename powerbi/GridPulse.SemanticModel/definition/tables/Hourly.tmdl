/// One row per distinct ERCO UTC hour ending for 2023–2025.
table Hourly
	lineageTag: fc596b3b-1c79-4001-b00f-dc0b0fef9700

	/// Maximum observed hourly demand in the selected context.
	measure 'Peak Demand MW' = MAX('Hourly'[demand_mw])
		formatString: #,##0 "MW"
		lineageTag: 9b73a9b0-b38c-410d-82e4-e3b0d77571eb

	/// First reporting date tied for the observed peak in context.
	measure 'Peak Reporting Date' =
			VAR Peak = [Peak Demand MW]
			RETURN IF(NOT ISBLANK(Peak), CALCULATE(MIN('Hourly'[reporting_date]), KEEPFILTERS('Hourly'[demand_mw] = Peak)))
		formatString: mmm d, yyyy
		lineageTag: 224fa06d-c142-4c2a-838c-b8ab92f67fef

	/// Mean observed demand over hours with both observations.
	measure 'Mean Paired Demand MW' = CALCULATE(AVERAGE('Hourly'[demand_mw]), KEEPFILTERS('Hourly'[paired_hour] = 1))
		formatString: #,##0 "MW"
		lineageTag: 241823c0-18c3-4de7-940e-7cccded3e6ad

	/// Mean day-ahead forecast over the same paired hours.
	measure 'Mean Paired Forecast MW' = CALCULATE(AVERAGE('Hourly'[forecast_mw]), KEEPFILTERS('Hourly'[paired_hour] = 1))
		formatString: #,##0 "MW"
		lineageTag: b4d3372d-e767-46c0-955f-ec712a4e987c

	/// Mean observed demand for hours with a reported demand value.
	measure 'Mean Observed Demand MW' = AVERAGE('Hourly'[demand_mw])
		formatString: #,##0 "MW"
		lineageTag: fca30f74-a301-4572-9e17-fbbd450ca646

	/// Count of hourly observations in the selected context.
	measure 'Reporting Hours' = COUNTROWS('Hourly')
		formatString: #,##0
		lineageTag: c7a3929d-1b2a-4ff1-a0fe-1c9dcfeef4e0

	/// Count of hours with both demand and forecast.
	measure 'Paired Hours' = COALESCE(SUM('Hourly'[paired_hour]), 0)
		formatString: #,##0
		lineageTag: fcae848c-5cd8-44b3-9a4b-75aa2f263bb9

	/// Paired hours divided by reporting hours in context.
	measure 'Paired Coverage' = DIVIDE([Paired Hours], [Reporting Hours])
		formatString: 0.00%
		lineageTag: 29123e27-116b-42bf-9a23-a2cd3a5d328b

	/// Mean magnitude of the day-ahead forecast error over paired hours.
	measure 'Forecast MAE MW' = DIVIDE(SUM('Hourly'[absolute_error_mw]), [Paired Hours])
		formatString: #,##0.0 "MW"
		lineageTag: 8e37df71-2d9c-4eaa-a22b-50b150ca8247

	/// Mean signed forecast minus demand. Positive indicates overforecasting.
	measure 'Forecast Bias MW' = DIVIDE(SUM('Hourly'[forecast_error_mw]), [Paired Hours])
		formatString: +#,##0.0 "MW";-#,##0.0 "MW";0.0 "MW"
		lineageTag: 9226454b-4853-4aa2-b030-0e85c5f95366

	column balancing_authority
		dataType: string
		lineageTag: c56d94f7-013e-410d-beca-8493aa2ac9b3
		summarizeBy: none
		sourceColumn: balancing_authority

	column reporting_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: ab97238e-83ad-4308-8d46-d32574119f1b
		summarizeBy: none
		sourceColumn: reporting_date

		annotation UnderlyingDateTimeDataType = Date

	column reporting_hour_number

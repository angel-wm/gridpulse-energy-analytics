		lineageTag: 457a1bc2-0658-48f3-8526-ee730788c5b4
		summarizeBy: sum
		sourceColumn: local_start_hour

		annotation SummarizationSetBy = Automatic

	column paired_hour
		dataType: int64
		lineageTag: 1fe295df-38e7-4c85-b749-02c94f0adbbd
		summarizeBy: sum
		sourceColumn: paired_hour

		annotation SummarizationSetBy = Automatic

	column forecast_error_mw
		dataType: int64
		lineageTag: 19996160-b286-410a-b041-d429a19f7dda
		summarizeBy: sum

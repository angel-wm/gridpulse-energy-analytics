		sourceColumn: hour_ending_utc

		variation Variation
			isDefault
			relationship: bf342365-1689-4679-b584-f04bd78f4938
			defaultHierarchy: LocalDateTable_b9197a20-2703-406f-8477-6b53f9e547af.'Date Hierarchy'

	column demand_mw
		dataType: int64
		lineageTag: c2494167-3fd2-4cdb-8693-f838ab28855b
		summarizeBy: sum
		sourceColumn: demand_mw

		annotation SummarizationSetBy = Automatic

	column forecast_mw
		dataType: int64
		lineageTag: f8b71dd5-3557-43a0-b0ea-963b59f19577
		summarizeBy: sum
		sourceColumn: forecast_mw

		annotation SummarizationSetBy = Automatic

	column net_generation_mw
		dataType: int64
		lineageTag: ef5f301e-8a3c-4b47-9937-3442e4229f40
		summarizeBy: sum
		sourceColumn: net_generation_mw

		annotation SummarizationSetBy = Automatic

	column source_file
